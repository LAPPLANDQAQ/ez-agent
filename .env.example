# ===================================================================
# Ez Agent 环境变量配置
# 复制此文件为 .env 并填入你的实际值
# cp .env.example .env
#
# 注意: .env 里不要放未在 app/config.py 定义的变量,
# pydantic-settings 会因 extra="forbid" 报错。
# 非应用变量(PYTHONPATH 等)请放 shell 配置或 .envrc(direnv)。
# ===================================================================

# ===== 必填 =====
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# ===== LLM 配置(有默认值,可选修改) =====
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== 备用 LLM(可选) =====
QWEN_API_KEY=
ZHIPU_API_KEY=

# ===== 搜索备用(可选) =====
SERPER_API_KEY=

# ===== 数据库(开发用 SQLite,生产切 PostgreSQL) =====
DATABASE_URL=sqlite+aiosqlite:///./research.db
# DATABASE_URL=postgresql+asyncpg://research:research_dev_pwd@localhost:5432/research

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Agent 参数 =====
MAX_ITERATIONS=3
TOKEN_BUDGET=100000
FETCH_TIMEOUT_SECONDS=10
RESEARCH_TIMEOUT_SECONDS=90
DEFAULT_TOP_K_PER_SEARCH=5

# ===== 可观测性(可选, 留空则不启用) =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ===== 应用 =====
APP_ENV=development
LOG_LEVEL=INFO
# API_PORT 仅作参考, 实际监听端口由 uvicorn/Docker 启动命令决定
API_PORT=8000